<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consejos del Día - ITSU</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #f0f4f8;        /* Azul grisáceo muy tenue y relajante */
            --card-bg: #ffffff;         /* Blanco puro para resaltar el contenido */
            --text-main: #2d3748;       /* Gris oscuro suave para alta legibilidad */
            --text-muted: #718096;      /* Gris medio para elementos secundarios */
            --accent-color: #a3e635;    /* Verde menta/lima tenue base */
            --accent-hover: #84cc16;    /* Verde un poco más vivo para el hover */
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg-color); 
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container { 
            background: var(--card-bg); 
            padding: 40px 30px; 
            border-radius: 20px; 
            max-width: 450px;
            width: 100%;
            box-shadow: var(--shadow); 
            text-align: center;
            transition: transform 0.3s ease;
        }

        /* Efecto sutil de flotado en la tarjeta */
        .container:hover {
            transform: translateY(-5px);
        }

        h1 {
            font-size: 1.5rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 25px;
            font-weight: 600;
        }

        /* Contenedor del consejo para centrar la atención */
        .advice-box {
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
            padding: 15px;
            border-radius: 12px;
            background-color: #f8fafc; /* Fondo interior casi imperceptible */
        }

        #advice-text { 
            font-style: italic; 
            color: var(--text-main); 
            font-size: 1.25rem; 
            line-height: 1.6;
            font-weight: 500;
            transition: opacity 0.3s ease;
        }

        /* Clase para la animación de aparición */
        .fade-in {
            opacity: 1;
            animation: fadeIn 0.6s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Botón estilizado interactivo */
        button { 
            padding: 14px 28px; 
            font-size: 16px; 
            font-weight: 600;
            cursor: pointer; 
            background-color: var(--accent-color); 
            color: #1a202c; /* Texto oscuro para contrastar con el color tenue */
            border: none; 
            border-radius: 50px; 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s ease;
        }

        button:hover { 
            background-color: var(--accent-hover); 
            transform: scale(1.03);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }

        button:active {
            transform: scale(0.98);
        }

        button i {
            font-size: 1.1rem;
            transition: transform 0.4s ease;
        }

        /* El icono gira levemente al pasar el mouse por el botón */
        button:hover i {
            transform: rotate(45deg);
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Generador de Consejos</h1>
        
        <div class="advice-box">
            <p id="advice-text" class="fade-in">Presiona el botón para recibir un consejo...</p>
        </div>

        <button onclick="obtenerConsejo()">
            <span>Obtener Consejo</span>
            <i class="fa-solid fa-wand-magic-sparkles"></i>
        </button>
    </div>

    <script>
        async function obtenerConsejo() {
            const adviceEl = document.getElementById('advice-text');
            
            try {
                // Consultamos a tu servidor local de Flask
                const response = await fetch('http://127.0.0.1:5000/get-advice');
                const data = await response.json();
                
                // Extraemos el texto del consejo
                const consejo = data.slip.advice;
                
                // Reiniciamos la animación quitando y poniendo la clase
                adviceEl.classList.remove('fade-in');
                void adviceEl.offsetWidth; // Truco de reflow para reiniciar CSS animation
                
                // Mostramos el consejo con comillas tipográficas elegantes
                adviceEl.innerText = `“${consejo}”`;
                adviceEl.classList.add('fade-in');

            } catch (error) {
                adviceEl.innerText = "Error al conectar con el servidor.";
                adviceEl.style.color = "#fc8181"; // Un rojo pastel muy suave para el error
            }
        }
    </script>
</body>
</html>
